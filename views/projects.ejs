<%
page.subtitle = page.title;
page.banner_img = page.banner_img || theme.page.banner_img;
page.banner_img_height = page.banner_img_height || theme.page.banner_img_height;
page.banner_mask_alpha = page.banner_mask_alpha || theme.page.banner_mask_alpha;
%>
<div class="projects-page">
  <header class="projects-intro">
    <h1>项目</h1>
    <p>目前维护两个 Agent 项目：Reliable Deep Research 用于深度研究，CourseAgent 用于课程作业。这里整理功能、实验记录和源码链接。</p>
    <nav class="project-jump-links" aria-label="项目快捷导航"><% site.data.projects.forEach(function(project) { %><a href="#<%= project.id %>"><%= project.name %> <span aria-hidden="true">↓</span></a><% }) %></nav>
  </header>
  <%- partial('_partials/project-showcase', { compact: false }) %>
  <section class="project-reading" aria-labelledby="project-reading-title">
    <h2 id="project-reading-title">相关文章</h2>
    <a href="<%= url_for('/2026/10/22/reliable-deep-research-recovery/') %>">Reliable Deep Research 的任务恢复设计 <span aria-hidden="true">↗</span></a>
    <a href="<%= url_for('/2026/10/27/courseagent/') %>">CourseAgent：课程作业生成与核验 <span aria-hidden="true">↗</span></a>
    <p>项目持续在 GitHub 更新，当前实现与运行方式以各仓库文档为准。</p>
  </section>
</div>
<script defer src="<%= url_for('/vendor/mermaid/mermaid.tiny.min.js') %>"></script>
<script defer src="<%= url_for('/js/project-diagrams.js') %>"></script>
